# Copy to .env: cp .env.example .env
# Vite loads .env automatically (unlike the Go backend's .env, which
# needs to be sourced by hand) — just restart `npm run dev` after editing.

# Base URL of the internal/api backend. Empty = same-origin (the default,
# useful behind a reverse proxy that serves both this SPA and the API).
# Empty uses Vite's /v1 development proxy, which keeps API responses and
# custom autofill-report headers same-origin in the browser.
VITE_API_BASE_URL=

# Freshness window in milliseconds — see src/verify/freshness.ts. Defaults
# to 30 days if unset. This is a DISPLAY policy only: it never loosens or
# tightens what "authentic" means (that's chain + signature verification,
# always required), only how old an authentic attestation is allowed to
# be before this page still calls it verified.
VITE_FRESHNESS_WINDOW_MS=2592000000
