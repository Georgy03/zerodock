# Copy this to .env (at the repo root) and fill in real values:
#   cp .env.example .env
#
# cmd/api reads plain environment variables via os.Getenv — it does NOT
# auto-load a .env file. Load it into your shell before running the
# server:
#   set -a; source .env; set +a; go run ./cmd/api
# or point it at Docker instead:
#   docker run --env-file .env ...

# Required. Postgres connection string, authenticating as the restricted
# zerodock_app role created by migrations/0001_init.sql (with every later
# migration applied too) — never the
# migration/owner role.
DATABASE_URL=postgres://zerodock_app:changeme@localhost:5432/zerodock?sslmode=disable

# Optional (default :8080).
LISTEN_ADDR=:8080

# Optional. Builds the share_url field in POST /v1/verdicts responses and
# the evidence link inserted into questionnaire answers.
PUBLIC_BASE_URL=http://localhost:8080

# Required. Public browser verifier used in exported questionnaire evidence
# links. In production this must be the buyer-facing HTTPS UI, not the JSON API.
BUYER_BASE_URL=http://localhost:5173

# Optional (default false). true accepts attestations that verify but
# chain to a mock root instead of the real AWS Nitro root — development/
# staging only. Never true wherever real buyer-facing verdicts are served.
ZERODOCK_ALLOW_MOCK_ATTESTATION=false

# Optional JSON file that replaces the embedded questionnaire mappings and
# may define account_overrides keyed by AWS account ID.
QUESTIONNAIRE_MAPPINGS_FILE=
