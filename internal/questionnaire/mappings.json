    {
      "keyword_groups": [["mfa", "remote access"], ["multi-factor", "remote access"]],
      "reason": "root-account MFA does not prove MFA is enforced for all remote access"
    },
    {
      "keyword_groups": [["backup", "tested"], ["backups", "tested"], ["restore", "tested"], ["recovery", "tested"]],
      "reason": "RDS backup retention does not prove backups or restores are tested"
    },
    {
      "keyword_groups": [["ai vendor"], ["do you use", "artificial intelligence"], ["do you use", "generative ai"], ["saas", "artificial intelligence"], ["chatgpt"]],
      "reason": "AWS-account evidence does not prove employee use of SaaS AI tools or that an available foundation model was actually invoked"
    }
  ],
